# 将配置注入进程环境；当前工程不自动加载.env文件。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=replace_with_local_user
DB_PASSWORD=replace_with_local_password
DB_NAME=dafu_shike
PORT=3000
JWT_SECRET=replace_with_random_secret
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 手机号登录须同时配置：随机盐至少16字符、AES密钥64个十六进制字符。
PHONE_HASH_SALT=
PHONE_ENCRYPTION_KEY=
# 不配置则手机号接口拒绝服务，不回退为明文存储；9位学号测试不依赖这两项。
